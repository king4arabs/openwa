{
    "name": "rmyndharis/openwa",
    "description": "Official PHP SDK for OpenWA WhatsApp API Gateway",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "whatsapp",
        "api",
        "sdk",
        "openwa",
        "gateway"
    ],
    "authors": [
        {
            "name": "OpenWA Contributors"
        }
    ],
    "require": {
        "php": "~8.2.35 || ~8.3.36 || ~8.4.27 || ^8.5.12",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "OpenWA\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenWA\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.5.x-dev"
        }
    }
}

